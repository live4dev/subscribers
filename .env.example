# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID чата, куда бот будет слать уведомления
# Чтобы узнать свой ID: напишите боту @userinfobot
NOTIFICATION_CHAT_ID=your_chat_id_here

# Для скрипта export_subscribers.py (MTProto API)
# Получить на https://my.telegram.org → API development tools
API_ID=your_api_id_here
API_HASH=your_api_hash_here
